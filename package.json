{
  "name": "gov-procurement-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "test:gemini": "node --experimental-strip-types --test scripts/gemini-client.test.ts",
    "test:intake": "node --experimental-strip-types --test scripts/intake-file.test.ts scripts/local-document-parser.test.ts",
    "test:rules": "node --experimental-strip-types --test scripts/procurement-guidance.test.ts",
    "test:workflow": "node --experimental-strip-types --test scripts/case-workflow.test.ts",
    "test:pcc-promote": "node --test scripts/pcc-promote.test.mjs",
    "test": "npm run test:gemini && npm run test:intake && npm run test:rules && npm run test:workflow && npm run test:pcc-promote",
    "preview": "vite preview",
    "pcc:watch": "node scripts/pcc-watcher.mjs",
    "pcc:assets": "node scripts/pcc-assets.mjs",
    "pcc:text": "node scripts/pcc-text.mjs",
    "pcc:audit": "node scripts/pcc-registry-audit.mjs",
    "pcc:promote": "node scripts/pcc-promote.mjs",
    "template:anchors": "node scripts/template-anchor-audit.mjs",
    "template:smoke": "node scripts/template-writer-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "dexie": "4.4.5",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "file-saver": "2.0.5",
    "vite": "8.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/file-saver": "2.0.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  }
}
